# Скопируйте этот файл как parentai.env. Сам parentai.env исключён из Git.
# Никогда не коммитьте реальные ключи.

# YandexGPT: yc.ai.languageModels.execute и роль ai.languageModels.user.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
PARENTAI_TUTOR_MODEL=yandexgpt-5-lite

# SpeechKit STT: yc.ai.speechkitStt.execute и роль ai.speechkit-stt.user.
# Если пусто, используется YANDEX_API_KEY при наличии нужной области.
YANDEX_SPEECHKIT_API_KEY=

# SpeechKit TTS v3: yc.ai.speechkitTts.execute и роль ai.speechkit-tts.user.
# Если пусто, используется ключ STT или YANDEX_API_KEY при наличии нужной области.
YANDEX_TTS_API_KEY=

# XTTS-v2 разрешён только для некоммерческой разработки и выключается заменой
# режима ответа на обычный голос SpeechKit. Для платной beta XTTS-v2 не использовать.
PARENTAI_VOICE_DEVICE=auto
PARENTAI_ENABLE_XTTS=0
