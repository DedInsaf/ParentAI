# Скопируйте этот файл как parentai.env и заполните два значения.
# Ключу достаточно области действия yc.ai.languageModels.execute.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Экономичная модель. Можно заменить моделью из вашего каталога Yandex Cloud.
PARENTAI_TUTOR_MODEL=yandexgpt-5-lite

# SpeechKit: отдельный ключ сервисного аккаунта с областью
# yc.ai.speechkitStt.execute и ролью ai.speechkit-stt.user.
# Если пусто, используется YANDEX_API_KEY (он должен иметь обе области доступа).
YANDEX_SPEECHKIT_API_KEY=
