# Скопируйте этот файл как parentai.env. Сам parentai.env исключён из Git.
# Никогда не коммитьте реальные ключи.

# Публичная beta: приложение слушает только локальный Caddy, который выдаёт HTTPS.
PARENTAI_BIND=127.0.0.1
PARENTAI_PUBLIC_ORIGIN=
# Общий предохранитель расходов всех аккаунтов; 0 отключает соответствующий предел.
PARENTAI_GLOBAL_DAILY_BUDGET_RUBLES=300
PARENTAI_GLOBAL_MONTHLY_BUDGET_RUBLES=3000

# YandexGPT: yc.ai.languageModels.execute и роль ai.languageModels.user.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Полная модель для надёжных рассуждений и школьных задач.
PARENTAI_TUTOR_MODEL=yandexgpt-5.1

# Распознавание речи по умолчанию выполняется локально и бесплатно.
PARENTAI_STT_ENGINE=local
PARENTAI_STT_MODEL=openai/whisper-small

# Необязательный SpeechKit STT используется только при явном
# PARENTAI_STT_ENGINE=yandex. Для него нужны yc.ai.speechkitStt.execute и
# роль ai.speechkit-stt.user. Если ключ пуст, используется YANDEX_API_KEY.
YANDEX_SPEECHKIT_API_KEY=

# SpeechKit TTS v3: yc.ai.speechkitTts.execute и роль ai.speechkit-tts.user.
# Если пусто, используется ключ STT или YANDEX_API_KEY при наличии нужной области.
YANDEX_TTS_API_KEY=

# XTTS-v2 разрешён только для некоммерческой разработки и выключается заменой
# режима ответа на обычный голос SpeechKit. Для платной beta XTTS-v2 не использовать.
PARENTAI_VOICE_DEVICE=auto
PARENTAI_ENABLE_XTTS=0

# Platega: данные магазина со страницы «Настройки» в личном кабинете.
# Эти значения используются только сервером и никогда не передаются браузеру.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
