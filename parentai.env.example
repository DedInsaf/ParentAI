# Скопируйте этот файл как parentai.env и заполните два значения.
# Ключу достаточно области действия yc.ai.languageModels.execute.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Экономичная модель. Можно заменить моделью из вашего каталога Yandex Cloud.
PARENTAI_TUTOR_MODEL=yandexgpt-5-lite

# SpeechKit: отдельный ключ сервисного аккаунта с областью
# yc.ai.speechkitStt.execute и ролью ai.speechkit-stt.user.
# Если пусто, используется YANDEX_API_KEY (он должен иметь обе области доступа).
YANDEX_SPEECHKIT_API_KEY=

# Быстрая озвучка обычным голосом Яндекса (не клонирование родителя).
# yc.ai.speechkitTts.execute и роль ai.speechkit-tts.user. Услуга платная.
# Если пусто, берётся ключ SpeechKit или YandexGPT с нужной областью доступа.
YANDEX_TTS_API_KEY=

# XTTS: auto выбирает Apple GPU (MPS), если доступен; cpu принудительно отключает GPU.
PARENTAI_VOICE_DEVICE=auto

# Один раз для владельца приложения: бесплатный проект developer.avaturn.me.
# Только имя проекта, без https:// и .avaturn.dev. Включите аватары T2.
# Пока не заполнено, снимки родителя никуда не отправляются.
PARENTAI_AVATURN_SUBDOMAIN=
