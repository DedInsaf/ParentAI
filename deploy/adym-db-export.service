[Unit]
Description=Build safe Adym analytics database snapshot
After=adym.service

[Service]
Type=oneshot
User=adym
Group=adym
WorkingDirectory=/opt/adym
ExecStart=/opt/adym/.venv/bin/python /opt/adym/scripts/export_admin_db.py --data-dir /opt/adym/data --output /opt/adym/data/admin-export.sqlite3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/adym/data

