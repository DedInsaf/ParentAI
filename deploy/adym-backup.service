[Unit]
Description=Back up Adym private application data
ConditionPathIsDirectory=/opt/adym/data

[Service]
Type=oneshot
User=adym
Group=adym
WorkingDirectory=/opt/adym
ExecStart=/opt/adym/.venv/bin/python /opt/adym/scripts/backup.py --data /opt/adym/data --destination /var/backups/adym --keep 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/adym
# SQLite may need to read or create its WAL/SHM companions while taking a
# consistent online backup. The service still runs as the unprivileged app user.
ReadWritePaths=/opt/adym/data /var/backups/adym
